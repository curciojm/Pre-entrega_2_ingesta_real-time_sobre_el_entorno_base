# Directorio de trabajo de Terraform
.terraform/

# Archivos de estado
*.tfstate
*.tfstate.*

# Variables locales o sensibles
*.tfvars
*.tfvars.json
.env
.env.*

# Archivos de crash
crash.log
crash.*.log

# Planes guardados
*.tfplan
tfplan
tfplan.txt

# Overrides locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Configuración local de Terraform
.terraformrc
terraform.rc

# Entornos virtuales de Python
.venv/
venv/

# Caché de Python
__pycache__/
*.py[cod]
